{
  "name": "a11y-review-agent-fixture",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "a11y:scan": "node .claude/skills/a11y-review/scripts/scan-patterns.mjs --base main",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "lint": "eslint src",
    "lint:a11y": "eslint src --format stylish",
    "test:a11y": "test-storybook --url http://localhost:6006",
    "test:a11y:ci": "test-storybook --url http://localhost:6006 --maxWorkers=2"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@storybook/test-runner": "^0.24.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.11.0",
    "http-server": "^14.1.1",
    "storybook": "^10.5.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.2.4",
    "wait-on": "^9.1.0"
  }
